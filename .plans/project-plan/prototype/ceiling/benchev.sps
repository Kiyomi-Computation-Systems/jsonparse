(import (rnrs) (rnrs mutable-pairs) (only (chezscheme) format real-time) (byte-machine runtime) (generated json))
(define stack-bindings
  (list (list 'object-start (lambda (p s) (set-car! s (cons 'object (car s))) callback-continue))
        (list 'array-start  (lambda (p s) (set-car! s (cons 'array (car s))) callback-continue))
        (list 'object-end   (lambda (p s) (set-car! s (cdar s)) callback-continue))
        (list 'array-end    (lambda (p s) (set-car! s (cdar s)) callback-continue))
        (list 'context      (lambda (p s) (caar s)))))
(define (run bv)
  (let ((p (make-parser json-parser stack-bindings (list '()))))
    (parser-feed! p bv 0 (bytevector-length bv))
    (assert (eq? 'finished (parser-result-status (parser-finish! p))))))
(for-each (lambda (f)
  (let* ((bv (call-with-port (open-file-input-port f) get-bytevector-all)) (reps 50) (t0 (real-time)))
    (do ((i 0 (+ i 1))) ((= i reps)) (run bv))
    (let ((ms (/ (- (real-time) t0) (inexact reps))))
      (format #t "  ~22a ~7,3f ms ~8,1f MB/s~%" f ms (/ (bytevector-length bv) ms 1000.0)))))
  '("ints-40k.json" "records-2k.json" "escaped-string.json"))
