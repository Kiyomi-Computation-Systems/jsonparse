(import (rnrs) (only (chezscheme) directory-list format) (bmjson dom) (prefix (json parser) cj:))
(define dir "JSONTestSuite/test_parsing/")
(define (read-bytes f) (call-with-port (open-file-input-port f) get-bytevector-all))
(define (bm f)
  (let ((bv (let ((x (read-bytes (string-append dir f)))) (if (eof-object? x) (make-bytevector 0) x))))
    (guard (e [(and (pair? e) (eq? (car e) 'json-error)) (list 'reject (cadr e))]
              [#t (list 'crash (if (message-condition? e) (condition-message e) e))])
      (let ((whole (json-parse bv)))
        (for-each (lambda (n)
                    (unless (equal? whole (json-parse-chunked bv n))
                      (raise (list 'json-error 'CHUNK-MISMATCH n))))
                  '(1 2 3 7))
        (list 'accept whole)))))
(define (cj f)
  (guard (e [#t 'reject])
    (let ((p (open-file-input-port (string-append dir f) (file-options) (buffer-mode block) (make-transcoder (utf-8-codec) (eol-style none) (error-handling-mode raise)))))
      (cj:json->scm p) 'accept)))
(define files (list-sort string<? (directory-list dir)))
(define tally (make-hashtable equal-hash equal?))
(define (bump! k) (hashtable-update! tally k (lambda (n) (+ n 1)) 0))
(define skip-cj '("n_structure_100000_opening_arrays.json" "n_structure_open_array_object.json"))
(for-each
 (lambda (f)
   (let* ((kind (substring f 0 1))
          (b (bm f)) (bv (car b))
          (c (if (member f skip-cj) 'skipped (cj f))))
     (bump! (list 'bm kind bv)) (bump! (list 'cj kind c))
     (when (or (and (string=? kind "y") (not (eq? bv 'accept)))
               (and (string=? kind "n") (eq? bv 'accept))
               (eq? bv 'crash))
       (format #t "BM WRONG ~a -> ~s~%" f b))
     (when (string=? kind "i") (format #t "i: ~a bm=~a cj=~a~%" f bv c))))
 files)
(let-values (((ks vs) (hashtable-entries tally)))
  (for-each (lambda (p) (format #t "~s ~a~%" (car p) (cdr p)))
            (list-sort (lambda (a b) (string<? (format "~s" (car a)) (format "~s" (car b))))
                       (map cons (vector->list ks) (vector->list vs)))))
