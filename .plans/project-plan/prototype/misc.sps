(import (rnrs) (only (chezscheme) format make-list) (byte-machine runtime) (generated json) (bmjson dom))
(define (try label thunk)
  (format #t "~a => ~s~%" label (guard (e [#t e]) (thunk))))
(define (bv s) (string->utf8 s))
(try "null vs [] vs {}" (lambda () (map json-parse (map bv '("null" "[]" "{}")))))
(try "key order kept" (lambda () (json-parse (bv "{\"b\":1,\"a\":2,\"b\":3}"))))
(try "bignum" (lambda () (json-parse (bv "123456789012345678901234567890"))))
(try "surrogate pair" (lambda () (json-parse (bv "\"\\ud83d\\ude00\""))))
(try "error offset" (lambda () (json-parse (bv "{\"a\": [1, 2,, 3]}"))))
(try "trailing" (lambda () (json-parse (bv "[1] x"))))
(try "depth 512 ok" (lambda () (vector? (json-parse (bv (string-append (apply string-append (make-list 512 "[")) (apply string-append (make-list 512 "]"))))))))
(try "depth 513" (lambda () (json-parse (bv (string-append (apply string-append (make-list 513 "[")) (apply string-append (make-list 513 "]")))))))
;; multiple values via the settable mode field
(let* ((count 0)
       (b (list (list 'context (lambda (p s) 'array)) (list 'number-end (lambda (p s) (set! count (+ count 1)) callback-continue))))
       (p (make-parser json-parser b #f '((mode . 1))))
       (in (bv "1 2 3 4")))
  (parser-feed! p in 0 (bytevector-length in))
  (format #t "multi-value mode: status ~s, numbers ~a~%" (parser-result-status (parser-finish! p)) count))
