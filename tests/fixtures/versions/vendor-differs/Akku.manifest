#!r6rs ; -*- scheme -*-
(import (akku format manifest))

;; The package installs the libraries under src/. tests/ is test code and is
;; not installed.
;;
;; depends: the generated parser imports (byte-machine runtime). The range's
;; floor is the version vendored in vendor/byte-machine, which the suites run
;; against, and Akku.lock locks the same version. `make check-pins` holds the
;; three together (ADR-0002).
;;
;; The version is 0.0.0 until the first release (plan M5).
(akku-package ("jsonparse" "0.0.0")
  (synopsis "A fast, strict JSON parser for R6RS Scheme, generated by byte-machine")
  (description
   "A resumable JSON parser: feed it bytes as they arrive, split anywhere. It is strict RFC 8259 by default, reports byte offsets, and builds trees or calls back with events."
   "Its libraries need only (rnrs) and byte-machine's runtime.")
  (authors "Kiyomi Computation Systems LLC")
  (homepage "https://github.com/Kiyomi-Computation-Systems/jsonparse")
  (license "BSD-3-Clause")
  (depends ("byte-machine" "^0.8.0")))
